# Пример окружения. Скопируйте в .env: cp .env.example .env
# Реальный .env в git не попадает.
# ВНИМАНИЕ: значения ниже — только для локальной разработки.
# На сервере замените POSTGRES_PASSWORD и REDIS_PASSWORD перед первым запуском.

# --- PostgreSQL ---
POSTGRES_USER=karamel
POSTGRES_PASSWORD=karamel_pass
POSTGRES_DB=karamel_db
DATABASE_URL=postgresql+asyncpg://karamel:karamel_pass@postgres:5432/karamel_db

# --- Redis ---
# requirepass обязателен: Redis используется для rate limiting,
# открытый экземпляр позволяет внешнему процессу менять ключи и обходить лимиты.
REDIS_PASSWORD=karamel_redis_pass
REDIS_URL=redis://:karamel_redis_pass@redis:6379/0

# --- Приложение ---
ENV=development
WEB_ORIGIN=http://localhost:3000
# API_URL для web — внутрикластерный адрес (стори 1.5, AC-03).
# BFF-прокси обращается к API по имени сервиса в docker-сети; снаружи
# порт 8000 опубликован только на 127.0.0.1 и браузером не используется.
# Значение читается сервером Next в момент запроса, а не при сборке,
# поэтому его можно менять без пересборки образа.
API_URL=http://api:8000

# --- OAuth (стори 1.3) ---
# Где взять:
#   Яндекс ID: https://oauth.yandex.ru/client/new  → «ID приложения» / «Пароль приложения»
#   VK ID:     https://id.vk.ru/about/business/go  → «ID приложения» / «Защищённый ключ»
# redirect_uri регистрируется у провайдера ровно как:
#   {API_URL}/api/v1/auth/yandex/callback
#   {API_URL}/api/v1/auth/vk/callback
# Пустые значения допустимы ТОЛЬКО при ENV=development: вне dev старт падает с ValueError.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# --- Сессии (стори 1.3) ---
# Ключ подписи access-токена (HS256). Сгенерировать: openssl rand -hex 32
# Значение ниже — маркер «локальная разработка»: ровно 32 символа, чтобы
# проходила валидация секретов. На стенде замените на `openssl rand -hex 32`.
# Дефолт `dev_only_secret` (15 символов) валидатор отклоняет: он короче 32.
JWT_SECRET=dev_only_jwt_secret_32_chars_min
OAUTH_STATE_TTL_SECONDS=600

# --- Домен session-cookie (стори 1.5, D-11) ---
# Пусто = host-only: cookie привязана к тому хосту, что отдал страницу,
# и НЕ уходит поддоменам. Это верное значение, когда Caddy отдаёт web и
# `/api/v1/*` с одного хоста (обычная схема: karamel.ru и karamel.ru/api).
#
# Заполнять только если web и API живут на разных поддоменах одного домена
# (например `app.karamel.ru` и `api.karamel.ru`): тогда нужно `karamel.ru`.
# Формат — домен без схемы и порта. Значение со схемой, портом или `@`
# роняет старт приложения с ValueError: такая cookie просто не установится,
# и пользователь будет выходить из аккаунта при каждом обновлении страницы.
SESSION_COOKIE_DOMAIN=

# --- SMS (стори 1.4) ---
# Провайдер: smsru (боевой) или stub (пишет код в лог, только dev/test).
# Вне development/staging stub запрещён валидатором: код попадал бы в лог.
SMS_PROVIDER=stub
# Где взять: личный кабинет SMS.ru → «API-ключи» https://sms.ru/my/api
# Стоимость SMS ~1–2 ₽. Пустое значение допустимо только при SMS_PROVIDER=stub:
# вне dev пустой ключ = падение на старте, а не отказ на первом живом входе.
SMSRU_API_ID=
# Перец HMAC-SHA256 для хранения кодов (в Redis открытый код не лежит).
# Сгенерировать для стенда: openssl rand -hex 32
# Короче 32 символов или дефолтное значение — падение на старте.
# Значение ниже — только для локальной разработки: замените на стенде.
SMS_CODE_SECRET=dev_only_sms_code_secret_please_replace_me

# Dev-заглушка: фиксированный код вместо генерации. Только при SMS_PROVIDER=stub
# и ENV=development|test. Пустое — обычная генерация.
SMS_STUB_FIXED_CODE=
# Список номеров через запятую. Пусто — код действует для любого номера.
SMS_STUB_FIXED_PHONES=

# --- S3 для дампов БД (стори 11.10, бакет `karamel-backup`) ---
# ОТДЕЛЬНЫЙ бакет от S3_BUCKET выше: там фото профилей, здесь дампы БД.
# Смешать нельзя — политика доступа у них разная. Префикс объектов: `db/`.
# Значения не попадают ни в git, ни в лог: только имена переменных.
S3_BACKUP_ENDPOINT=https://s3.twcstorage.ru
S3_BACKUP_REGION=ru-1
S3_BACKUP_BUCKET=your-backup-bucket-id
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=
# Сколько дней держать объекты в S3 (решение владельца Б-2, AC-3).
S3_RETENTION_DAYS=30

# --- S3 (Timeweb Cloud, ДЦ РФ) ---
# Приватный бакет для фото профиля. Публичный доступ запрещён:
# выдача только через подписанные URL (media_service, стори 2.2).
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
# Идентификатор бакета стенда в git не хранится: подставьте свой.
S3_BUCKET=your-bucket-id
S3_ACCESS_KEY=
S3_SECRET_KEY=
# TTL подписанной ссылки на фото, секунды
S3_SIGNED_URL_TTL=900
# Предел размера самого файла фото (байт), не тела multipart.
# Диапазон 1048576..10485760 проверяется на старте: 0 отбил бы любое
# фото, больше памяти контейнера — исходный OOM. Точный размер файла
# проверяет photo_validation; гард тела получает max_photo_bytes + 64 КиБ.
MAX_PHOTO_BYTES=5242880

# --- Город пилота (стори 2.3, FR16, D-6) ---
# Эталон нормализации города: `'томск'`, `'ТОМСК'`, `'Томск '` приводятся
# к этому написанию перед записью в `profiles.city`. Меняется конфигурацией
# без изменения кода (FR16). Пустое значение или длиннее 100 символов —
# падение на старте: эталон участвует в сравнении на каждом сохранении.
PILOT_CITY=Томск
# Прямоугольник пилота: lat_min,lat_max,lng_min,lng_max.
# Геокодер не вызывается: координаты сравниваются с этой константой в памяти
# (трансграничная передача, NFR34/152-ФЗ). Перепутанные местами широта и
# долгота, перевёрнутые границы или выход за -90..90/-180..180 — падение
# на старте, а не тихий ответ «вне города пилота».
PILOT_CITY_BBOX=56.30,56.60,84.80,85.20
# --- Дата старта пилота (стори 10.5, AC-03, NFR6, D-10.5-2) ---
# Источник «14-го дня» для предупреждения «явка ниже 10%». Задаётся решением
# владельца, а не выводится из первой карточки: пилот стартует не тогда,
# когда кто-то опубликовал встречу.
#
# Закомментировано намеренно: `None` легален и означает «дата неизвестна» —
# кабинет отдаёт `pilot_day: null`, предупреждение NFR6 не выводится.
# Честное «неизвестно» лучше выдуманного дня, который включил бы
# предупреждение не в тот момент.
#
# Часовой пояс ОБЯЗАТЕЛЕН (ADR-16): `2026-11-01T00:00:00` без пояса роняет
# старт с ValidationError — иначе день пилота зависел бы от локального
# времени процесса и на машине разработчика отличался бы от контейнера.
# PILOT_STARTED_AT=2026-11-01T00:00:00+07:00

# --- Сообщества (стори 3.1, ADR-01, FR66) ---
# Список сообществ через запятую. Таблицы `communities` нет (пилот — одно
# сообщество, NFR46): срез живёт колонкой `places.community_slug` и этим
# конфигом. Второе сообщество включается здесь, без правки кода (ADR-01).
# Каждый слаг обязан соответствовать `^[a-z0-9_-]{3,64}$` (нижний регистр:
# `Tomsk` роняет старт, а не превращается тихо в `tomsk`) и пройти
# нормализацию — NBSP из копипаста снимается, а не создаёт «невидимое
# сообщество». Пустой список — падение на старте.
CITY_SLUGS=tomsk
# Город по умолчанию: обязан входить в CITY_SLUGS, иначе старт падает.
# Иначе создание места без явного слага отказывало бы всегда.
DEFAULT_CITY_SLUG=tomsk
# Стори 12.1 (AC-6, ADR-23): зона города из базы IANA. Нужна, чтобы `starts_at`
# (UTC в БД) отображался по местному времени города. Неизвестная зона роняет
# старт (`ZoneInfoNotFoundError` на первом запросе был бы `500` на валидной
# форме), а не выясняется при первом показе карточки.
CITY_TIMEZONE=Asia/Tomsk

# Предел размера тела запроса (байт). Фикс OOM 2026-10-22: тело читается
# в память целиком, поэтому 10 МБ роняли контейнер api. Диапазон
# 1024..33554432 проверяется на старте (fail-fast). 1 МиБ с запасом
# покрывает любую легальную анкету (единицы КБ).
# Маршрут загрузки фото (стори 2.2) имеет собственный лимит через карту
# `overrides` в `core/body_limit.py`: MAX_PHOTO_BYTES + 64 КиБ на
# границы multipart. Остальные маршруты остаются на этом пределе.
MAX_REQUEST_BODY_BYTES=1048576

# --- Алертинг (стори 10.7, NFR62, ADR-14) ---
# Канал алертов — бот в мессенджере (NFR62). Токен берётся у @BotFather,
# Chat ID — у бота (например, `@userinfobot`).
#
# ПУСТОЕ ЗНАЧЕНИЕ = АЛЕРТИНГ ВЫКЛЮЧЕН, и это НЕ ошибка старта (D-10.7-4):
# probe поднимается в dev и CI, где бота нет. Алертинг, блокирующий старт,
# сам стал бы единой точкой отказа — ровно тем, что он призван обнаруживать.
# При пустом токене воркер пишет одно событие `alert.disabled` и работает.
#
# В GIT ЭТИ ЗНАЧЕНИЯ НЕ ПОПАДАЮТ: реальные — в `.env` на стенде (как
# YANDEX_CLIENT_SECRET). Значения ниже намеренно пустые.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Интервал цикла health-probe, секунды (30..3600, D-10.7-5). 60 с: две неудачи
# подряд дают алерт не позже ~2 минут. Ниже 30 с — один сетевой флейк даёт
# ложный алерт, и бот замьючен в первый день.
ALERT_PROBE_INTERVAL_SECONDS=60
# Сколько неудач ПОДРЯД считается инцидентом (>= 2, D-10.7-2). 1 отменяет
# защиту от флейка — валидатор такое значение роняет на старте.
ALERT_CONSECUTIVE_FAILURES=2

# --- Версия текста правил (стори 11.4, NFR36) ---
# Что это: редакция правил модерации, которую фиксирует `POST /consent`
# в `users.consent_version`. По ней владелец видит, кто принял 1.1, кто 1.2,
# а кто ещё ничего не переподтверждал (`NULL`).
#
# ИСТОЧНИК ИСТИНЫ — `MODERATION_RULES_VERSION` в файле
# `apps/web/src/lib/moderation-rules.ts`: текст правил живёт в коде фронтенда
# осознанно (D-10.4-1). Значение здесь обязано совпадать с ним, иначе
# красный тест `services/api/tests/unit/test_rules_version_alignment.py`.
#
# Бамп делается ВМЕСТЕ с правкой текста правил и его хеш-гардом — иначе
# пользователи «примут» новую редакцию, которой не читали.
# Формат строго `X.Y` (валидатор на старте), не длиннее 16 символов
# (ширина колонки `users.consent_version`).
MODERATION_RULES_VERSION=1.0
